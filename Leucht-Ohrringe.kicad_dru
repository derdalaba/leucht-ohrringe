(version 1)
(rule "Minimum annular width 1"
	(constraint annular_width (min 0.05mm))
)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.2mm))
)
(rule "Hole to hole distance 1"
	(constraint hole_to_hole (min 0.45mm))
)
(rule "Via style 1"
	(constraint via_diameter (min 0.45mm) (max 1mm))
	(constraint hole_size (min 0.2mm) (max 0.45mm))
)
(rule "Copper to edge clearance 1"
	(constraint edge_clearance (min 0.2mm))
)
